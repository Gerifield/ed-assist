; Elite Dangerous Status Helper Configuration
[general]
; Custom path to Status.json.
; If left empty or omitted, ed-assist auto-determines the path:
; Windows: %USERPROFILE%\Saved Games\Frontier Developments\Elite Dangerous\Status.json
; Linux:   $HOME/Saved Games/Frontier Developments/Elite Dangerous/Status.json
status_file = 

; Update detection mode:
; watch = event-driven via OS notifications (0% CPU when idle / docked)
; poll  = periodic polling every poll_interval_ms
mode = watch

; Polling interval in milliseconds (used when mode = poll, default: 250ms = 1/4 second)
poll_interval_ms = 250

; Quick retry settings in case the game is midway writing the file or holding a file lock
max_retries = 3
; Delay/wait time between retries: accepts milliseconds integer or duration string (e.g. 25, 25ms, 50ms)
retry_time_ms = 25
; alias: retry_delay_ms = 25 / retry_delay = 25ms

; Logging configuration (debug, info, warn, error)
loglevel = info
; logfile = ed-assist.log

; Model Context Protocol (MCP) server support
; Set to true to start the MCP server for LLM integration (Claude Desktop, Cursor, etc.)
enable_mcp = false

; MCP transport protocol: "stdio" or "http" (default: "stdio")
; stdio = standard I/O (for local command-based MCP clients like Claude Desktop)
; http  = HTTP Server-Sent Events (SSE). In http mode, terminal displays live event logs
;         while serving MCP concurrently at http://<mcp_addr>/sse
mcp_transport = stdio

; HTTP listen address / port for MCP when mcp_transport = http (default: 127.0.0.1:8080)
; Accepts "127.0.0.1:8080", ":8080", or simply port number "8080"
mcp_addr = 127.0.0.1:8080

; Optional system tracking (latest 100 visited systems & 100 targeted destinations in SQLite)
; Set to true or launch with -track to enable
enable_tracking = false

; SQLite database path for visited and targeted system tracking (used when enable_tracking = true)
; If empty or omitted, defaults to ed_assist.db located next to the binary
db_path = 

; Optional in-game control via DirectInput hardware scancodes and active .binds file
; Enables MCP tools: send_game_command and list_game_commands
game_control = false

; Key press hold duration in milliseconds (default: 80ms, minimum recommended: 50-100ms)
key_hold_ms = 80

; Custom path to Elite Dangerous Bindings folder or .binds file
; If empty, auto-detects from %LOCALAPPDATA%\Frontier Developments\Elite Dangerous\Options\Bindings
bindings_path =

; Web Cockpit Assistant & AI Configuration (for ed-assist-web)
; Web UI listen address and port (default: 127.0.0.1:3000)
web_addr = 127.0.0.1:3000

; AI Provider selection: "gemini" (default) or "openai" (OpenAI-compatible)
; "openai" mode supports OpenAI, DeepSeek, Groq, Ollama, LM Studio, OpenRouter, etc.
ai_provider = gemini

; Audio input processing strategy:
; transcribe = pre-transcribe voice audio to text via STT, then send pure text prompt to AI (default)
; native     = send raw audio bytes directly to multimodal AI (e.g. Gemini)
audio_input_mode = transcribe

[stt]
; Speech-to-Text configuration (automatically enabled when audio_input_mode = transcribe)
; Chosen backend: "groq", "openai", "local_whisper"
backend = groq

; Groq API key (or export GROQ_API_KEY environment variable)
groq_api_key =
groq_model = whisper-large-v3-turbo

; Base URL for OpenAI-compatible STT endpoint (default: https://api.groq.com/openai/v1)
openai_base_url = https://api.groq.com/openai/v1

; Elite Dangerous specific prompt vocabulary to improve Whisper transcription accuracy
prompt_vocabulary = FSD, Frame Shift Drive, SCB, SRV, COVAS, Chaff, Heatsink, Pips, Limpet, Supercruise, Coriolis, Thargoid, Witchspace

[ai]
; --- Google Gemini Configuration (when ai_provider = gemini) ---
; Google Gemini API key (or export GEMINI_API_KEY environment variable)
gemini_api_key = 

; Gemini model to use for chat & voice reasoning (default: gemini-flash-lite-latest)
gemini_model = gemini-flash-lite-latest

; Optional custom Gemini API endpoint
; gemini_base_url = https://generativelanguage.googleapis.com/v1beta

; --- OpenAI / OpenAI-compatible Configuration (when ai_provider = openai) ---
; API key for OpenAI or compatible provider (or export OPENAI_API_KEY environment variable)
; Can be left empty for local Ollama / LM Studio without authentication.
openai_api_key = 

; Model identifier (e.g. gpt-4o-mini, deepseek-chat, llama3.1, mistral)
openai_model = gpt-4o-mini

; Base URL for OpenAI-compatible endpoint (default: https://api.openai.com/v1)
; Examples:
;   DeepSeek:   https://api.deepseek.com/v1 (or https://api.deepseek.com)
;   Groq:       https://api.groq.com/openai/v1
;   Ollama:     http://localhost:11434/v1
;   LM Studio:  http://localhost:1234/v1
;   OpenRouter: https://openrouter.ai/api/v1
openai_base_url = https://api.openai.com/v1

; Custom system instruction prompt for COVAS cockpit assistant.
; If left empty or omitted, the default Elite Dangerous COVAS cockpit assistant prompt is used.
; You can provide text directly (single line or indented multi-line) or a path to a text file (e.g. covas_prompt.txt).
system_prompt = 

; Maximum tool calling rounds per conversation turn to prevent infinite loops (default: 10)
max_tool_rounds = 10

; Automatically inject current ship chronometer and UTC / in-game Galaxy time into system prompt
; Enables COVAS to always know the current time without wasteful tool calling rounds (true / false, default: true)
auto_time_context = true

; MCP connection mode for ed-assist-web:
; "inprocess" = run MCP server & game watcher directly inside the web binary (all-in-one)
; "http"      = connect to external ed-assist running MCP over HTTP/SSE (default: http://127.0.0.1:8080/sse)
; "stdio"     = spawn ed-assist subprocess over stdin/stdout
gemini_mcp_mode = inprocess

; MCP endpoint URL or binary path when gemini_mcp_mode is http or stdio
gemini_mcp_endpoint = http://127.0.0.1:8080/sse

; Automatic VOX Noise Gate settings for voice recording:
; Default trigger volume threshold percentage (0 - 100, default: 40)
voice_gate_threshold = 40

; Silence duration in milliseconds before auto-transmitting voice recording (default: 2000ms = 2s)
voice_silence_ms = 2000

; Acoustic echo protection: automatically suppress VOX microphone trigger while COVAS
; reads aloud through speakers to prevent microphone loopback (true / false, default: true)
voice_echo_protection = true


; Galaxy intelligence external API cache time in hours (EDSM / Spansh)
; Cached persistently in SQLite api_cache table (default: 8 hours)
system_cache_hours = 8


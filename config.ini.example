; Elite Dangerous Status Helper Configuration
[general]
; Custom path to Status.json.
; If left empty or omitted, ed-assist auto-determines the path:
; Windows: %USERPROFILE%\Saved Games\Frontier Developments\Elite Dangerous\Status.json
; Linux:   $HOME/Saved Games/Frontier Developments/Elite Dangerous/Status.json
status_file = 

; Update detection mode:
; watch = event-driven via OS notifications (0% CPU when idle / docked)
; poll  = periodic polling every poll_interval_ms
mode = watch

; Polling interval in milliseconds (used when mode = poll, default: 250ms = 1/4 second)
poll_interval_ms = 250

; Quick retry settings in case the game is midway writing the file or holding a file lock
max_retries = 3
; Delay/wait time between retries: accepts milliseconds integer or duration string (e.g. 25, 25ms, 50ms)
retry_time_ms = 25
; alias: retry_delay_ms = 25 / retry_delay = 25ms

; Logging configuration (debug, info, warn, error)
loglevel = info
; logfile = ed-assist.log

; Model Context Protocol (MCP) server support
; Set to true to start the MCP server for LLM integration (Claude Desktop, Cursor, etc.)
enable_mcp = false

; MCP transport protocol: "stdio" or "http" (default: "stdio")
; stdio = standard I/O (for local command-based MCP clients like Claude Desktop)
; http  = HTTP Server-Sent Events (SSE). In http mode, terminal displays live event logs
;         while serving MCP concurrently at http://<mcp_addr>/sse
mcp_transport = stdio

; HTTP listen address / port for MCP when mcp_transport = http (default: 127.0.0.1:8080)
; Accepts "127.0.0.1:8080", ":8080", or simply port number "8080"
mcp_addr = 127.0.0.1:8080

; Optional system tracking (latest 100 visited systems & 100 targeted destinations in SQLite)
; Set to true or launch with -track to enable
enable_tracking = false

; SQLite database path for visited and targeted system tracking (used when enable_tracking = true)
; If empty or omitted, defaults to ed_assist.db located next to the binary
db_path = 

; Optional in-game control via DirectInput hardware scancodes and active .binds file
; Enables MCP tools: send_game_command and list_game_commands
game_control = false

; Key press hold duration in milliseconds (default: 80ms, minimum recommended: 50-100ms)
key_hold_ms = 80

; Custom path to Elite Dangerous Bindings folder or .binds file
; If empty, auto-detects from %LOCALAPPDATA%\Frontier Developments\Elite Dangerous\Options\Bindings
bindings_path =
